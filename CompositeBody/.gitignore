# Unity ignores for THIS project folder.
#
# The repository root also has a Unity .gitignore, but its patterns are root-anchored
# (e.g. "/[Ll]ibrary/") and this Unity project lives one directory below the repo root,
# so those patterns never matched and Library/ ended up committed. Keeping this file
# inside the project folder makes the anchored patterns resolve correctly, and keeps
# working no matter where the project sits in the repo.

# Contains a Meta XR SDK accessToken. Machine-local and regenerated by the SDK, so it must
# not be committed -- anything pushed here would stay in git history permanently.
/[Aa]ssets/Resources/DevAgentSettings.asset
/[Aa]ssets/Resources/DevAgentSettings.asset.meta

# Unity crash-recovery scratch scenes.
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Regenerable caches. These contain machine-specific absolute paths, so syncing them
# between machines corrupts the build pipeline (ILPP / Bee failures).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Never commit built players.
/[Bb]uild*/
*.apk
*.aab
*.app

# Memory captures can be huge and may contain sensitive data.
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / tooling
.vs/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Crash / diagnostics
sysinfo.txt
mono_crash.*
*.log

# Auto-generated test scenes
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
InitTestScene*.unity*
