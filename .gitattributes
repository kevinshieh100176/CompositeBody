# Auto detect text files and perform LF normalization
* text=auto
*.a filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
CompositeBody/Library/ArtifactDB filter=lfs diff=lfs merge=lfs -text

# Point clouds: the 真人 are point clouds, so these are the biggest files here.
*.ply filter=lfs diff=lfs merge=lfs -text
*.pcache filter=lfs diff=lfs merge=lfs -text
CompositeBody/Assets/_models/**/*.asset filter=lfs diff=lfs merge=lfs -text

# Art, from the IX work.
*.fbx filter=lfs diff=lfs merge=lfs -text
# FBX files committed before LFS tracking stay as regular git blobs
CompositeBody/Assets/Samples/**/*.fbx !filter !diff !merge text=auto
CompositeBody/Assets/VRMPAssets/**/*.fbx !filter !diff !merge text=auto
CompositeBody/Assets/_models/Ch36_nonPBR*.fbx !filter !diff !merge text=auto
*.png filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text

# Voice-over. Over a gigabyte of it, and single takes run past GitHub's 100 MB
# limit for ordinary blobs, so a push without this is rejected outright.
*.wav filter=lfs diff=lfs merge=lfs -text
# WAV files committed before LFS tracking stay as regular git blobs
CompositeBody/Assets/Samples/**/*.wav !filter !diff !merge text=auto
CompositeBody/Assets/VRMPAssets/**/*.wav !filter !diff !merge text=auto
